# StandUp 환경 설정
# ========================================
# Bootstrap 필수 (DB 연결 전에 필요, .env 전용)
# ========================================

# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/standup

# 로깅
LOG_LEVEL=INFO

# API 포트
API_PORT=9060

# ========================================
# Legacy (DB 설정으로 이전 가능, fallback으로 유지)
# POST /api/v1/config/seed 로 DB에 시드 가능
# ========================================

# Gmail SMTP
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# 이메일 수신자 (콤마 구분)
REPORT_RECIPIENTS=recipient@example.com

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your_org

# 스케줄러
DAILY_REPORT_HOUR=17
DAILY_REPORT_MINUTE=0
WEEKLY_REPORT_HOUR=10
WEEKLY_REPORT_MINUTE=0
MONTHLY_REPORT_HOUR=11
MONTHLY_REPORT_MINUTE=0

# 보고서 표시 제한
MAX_PROJECTS_PER_CATEGORY=5
MAX_ITEMS_PER_PROJECT=3

# ========================================
# Insight Newsletter (v2) — exaone3.5 cascade
# ========================================

# 모드: legacy (기존) | insight (신규 주간) | both (병행, 권장 전환기)
STANDUP_MODE=both

# Ollama (host 에 설치됨 — 컨테이너에서 host.docker.internal 로 접근)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_SUMMARIZE=llama3.2:3b
OLLAMA_MODEL_ANALYZE=qwen2.5-coder:14b
OLLAMA_MODEL_COMPOSE=exaone3.5:7.8b
OLLAMA_MODEL_EMBED=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_TIMEOUT_SEC=600

# 주간 발송 (KST, 월요일 09:00)
INSIGHT_WEEKLY_DOW=mon
INSIGHT_WEEKLY_HOUR=9
INSIGHT_WEEKLY_MINUTE=0
INSIGHT_WINDOW_DAYS=7
INSIGHT_SUBJECT_PREFIX=[StandUp Insight]

# Ingestion 소스
LOGANALYZER_BASE_URL=http://host.docker.internal:9092
LOGANALYZER_ENABLED=true

GITHUB_QA_ENABLED=false
GITHUB_QA_REPOS=
GITHUB_QA_LABEL=qa-agent

AUTO_TOBE_ENABLED=false
AUTO_TOBE_JOURNAL_GLOB=
AUTO_TOBE_GIT_REPOS=

# Tech Trend (Medium Daily Digest 리포트 + Google/Naver 뉴스 검색)
# medium-digest-agent 가 생성한 Markdown 리포트(reports/) 를 흡수하고
# 키워드별로 Google News RSS / Naver News API 로 보강 → 주간 뉴스레터의
# "이번 주 기술 토픽" 섹션 + HopenVision 적용 제안에 사용.
TECH_TREND_ENABLED=false
TECH_TREND_KEYWORDS=java,spring,react
MEDIUM_DIGEST_REPORTS_DIR=
TECH_NEWS_MAX_PER_KEYWORD=5
TECH_NEWS_WORKERS=4
TECH_NEWS_TIMEOUT_SEC=15

# Naver News API (선택 — 미설정 시 Google News RSS 만 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
